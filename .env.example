# Form mode: demo = show successful submission without sending email; email = real delivery
CONTACT_FORM_MODE=demo

# Public site configuration
NEXT_PUBLIC_SITE_URL=https://sbs.expert

# Email delivery (Resend)
# Keep RESEND_API_KEY server-side only. In Vercel, store it as a Secret.
RESEND_API_KEY=
CONTACT_EMAIL=info@sbs.expert
# Must be a verified sender on your Resend domain, e.g. "Sapphire Consulting <website@sbs.expert>"
CONTACT_FROM=

# Optional: send the same structured payload to a webhook / automation platform.
CONTACT_WEBHOOK_URL=
